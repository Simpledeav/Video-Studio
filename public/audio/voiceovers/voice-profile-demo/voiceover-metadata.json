      "cached": false,
      "review": null
    },
    {
      "id": "revelation",
      "index": 5,
      "text": "Then the numbers moved. Developers adopted it, investors noticed, and in 2020 Stripe acquired Paystack for about two hundred million dollars. It was one of the largest exits in Nigerian tech at the time.",
      "preset": "revelation",
      "startSeconds": 38.811,
