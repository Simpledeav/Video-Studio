      "review": null
    },
    {
      "id": "idea",
      "index": 3,
      "text": "So they built a simpler checkout. One integration, one dashboard, and money that arrived where it was needed.",
      "preset": "business_explanation",
      "startSeconds": 19.141,
      "endSeconds": 26.281,
      "durationSeconds": 7.14,
