      "cached": true,
      "review": null
    },
    {
      "id": "tension",
      "index": 4,
      "text": "The market was crowded. Trust was scarce. And every merchant wanted proof before switching. Growth was possible, but only if the product worked every single day.",
      "preset": "tension",
      "startSeconds": 26.831,
      "endSeconds": 38.161,
      "durationSeconds": 11.33,
      "targetSeconds": 14.0,
      "audioPath": "/audio/voiceovers/voice-profile-demo/scene-004.wav",
