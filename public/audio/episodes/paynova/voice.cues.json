  "cues": [
    {
      "start": 0.437,
      "end": 3.773,
      "text": "One database query can wreck a growing fintech app."
    },
    {
      "start": 3.988,
      "end": 6.335,
      "text": "The problem might not even be traffic."
    },
    {
      "start": 6.804,
      "end": 7.865,
      "text": "Meet PAYNOVA."
    },
    {
      "start": 8.105,
      "end": 11.277,
      "text": "A fast-growing fintech startup processing transactions,"
    },
    {
      "start": 11.604,
      "end": 15.689,
      "text": "balances, and transaction histories for thousands of active customers."
    },
    {
      "start": 16.223,
      "end": 19.482,
      "text": "But one history query kept pulling far too much data."
    },
    {
      "start": 19.722,
      "end": 21.807,
      "text": "Instead of an efficient access path,"
    },
    {
      "start": 21.935,
      "end": 25.64,
      "text": "the database repeatedly scanned the entire transactions table for one"
    },
    {
      "start": 25.76,
      "end": 26.858,
      "text": "user's records."
    },
    {
      "start": 27.378,
      "end": 31.738,
      "text": "As traffic increased, that inefficient query consumed more resources."
    },
    {
      "start": 31.978,
      "end": 34.413,
      "text": "Requests began piling up in queues."
    },
    {
      "start": 34.628,
      "end": 38.376,
      "text": "The API slowed down, and the whole application felt the pressure."
    },
    {
      "start": 38.869,
      "end": 42.717,
      "text": "Daniel opened the execution plan and found the real bottleneck."
    },
    {
      "start": 42.957,
      "end": 46.050000000000004,
      "text": "The database was performing a full table scan instead of"
    },
    {
      "start": 46.17,
      "end": 48.792,
      "text": "an efficient indexed lookup on the right columns."
    },
    {
      "start": 49.293,
      "end": 52.548,
      "text": "The team optimized the query and added an appropriate composite"
    },
    {
      "start": 52.668,
      "end": 54.554,
      "text": "index based on the query pattern,"
    },
    {
      "start": 54.894,
      "end": 56.791,
      "text": "selectivity, and sort order."
    },
    {
      "start": 57.018,
      "end": 60.666,
      "text": "The new plan retrieved the right records far more efficiently."
    },
    {
      "start": 61.132,
      "end": 62.855,
      "text": "The application recovered."
    },
    {
      "start": 63.083,
      "end": 64.942,
      "text": "But the real lesson was bigger."
    },
    {
      "start": 65.182,
      "end": 67.618,
      "text": "Database performance has to be monitored,"
    },
    {
      "start": 67.82,
      "end": 72.68,
      "text": "tested, and designed before rapid growth exposes the hidden weaknesses."
    },
    {
      "start": 73.189,
      "end": 76.06899999999999,
      "text": "What would you investigate first: the database,"
    },
    {
      "start": 76.189,
      "end": 77.737,
      "text": "the API, or the queue?"
    }
  ]
}
