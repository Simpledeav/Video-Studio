  "segments": [
    {
      "id": "hook-problem",
      "text": "Your mechanic found a problem with your car.",
      "emotion": "suspense",
      "rate": "+20%",
      "pitch": "-3Hz",
      "start": 0.3,
      "duration": 1.872,
      "end": 2.172,
      "words": 8
    },
    {
      "id": "hook-calls",
      "text": "But why do you need five phone calls just to find out what it is?",
      "emotion": "suspense",
      "rate": "+18%",
      "pitch": "-4Hz",
      "start": 2.292,
      "duration": 2.832,
      "end": 5.124,
      "words": 15
    },
    {
      "id": "problem-juggle",
      "text": "Behind the scenes, the garage owner is juggling customer calls, repair estimates, mechanics, spare parts, payment confirmations and job updates.",
      "emotion": "concern",
      "rate": "+24%",
      "pitch": "-3Hz",
      "start": 8.25,
      "duration": 7.848,
      "end": 16.098,
      "words": 20
    },
    {
      "id": "problem-notebook",
      "text": "Some information is in a notebook.",
      "emotion": "concern",
      "rate": "+24%",
      "pitch": "-3Hz",
      "start": 16.298,
      "duration": 1.872,
      "end": 18.17,
      "words": 6
    },
    {
      "id": "problem-spreadsheet",
      "text": "Some is in a spreadsheet.",
      "emotion": "concern",
      "rate": "+24%",
      "pitch": "-3Hz",
      "start": 18.33,
      "duration": 1.872,
      "end": 20.202,
      "words": 5
    },
    {
      "id": "problem-phone",
      "text": "Some is buried in someone's phone.",
      "emotion": "concern",
      "rate": "+24%",
      "pitch": "-3Hz",
      "start": 20.362,
      "duration": 1.872,
      "end": 22.234,
      "words": 6
    },
    {
      "id": "research-expect",
      "text": "And customers increasingly expect more transparency.",
      "emotion": "explanatory",
      "rate": "+20%",
      "pitch": "-2Hz",
      "start": 23.05,
      "duration": 3.6,
      "end": 26.65,
      "words": 6
    },
    {
      "id": "research-understand",
      "text": "They want to understand what is wrong with their vehicle, see the price, and approve repairs without chasing the garage.",
      "emotion": "explanatory",
      "rate": "+22%",
      "pitch": "-2Hz",
      "start": 26.81,
      "duration": 5.376,
      "end": 32.186,
      "words": 20
    },
    {
      "id": "reveal-imagine",
      "text": "Now imagine giving that garage one simple system to manage every repair.",
      "emotion": "revelation",
      "rate": "+20%",
      "pitch": "-2Hz",
      "start": 33.25,
      "duration": 4.776,
      "end": 38.026,
      "words": 12
    },
    {
      "id": "reveal-moment",
      "text": "From the moment a customer arrives, until the vehicle is handed back.",
      "emotion": "revelation",
      "rate": "+20%",
      "pitch": "-3Hz",
      "start": 38.226,
      "duration": 3.6,
      "end": 41.826,
      "words": 12
    },
    {
      "id": "demo-books",
      "text": "A customer books a repair.",
