      "rate": "+22%",
      "pitch": "-2Hz",
      "start": 72.466,
      "duration": 5.04,
      "end": 77.506,
      "words": 15
    },
    {
      "id": "offer-runs",
      "text": "And if your business runs like this, SimpleDeav builds custom systems around how your company works.",
