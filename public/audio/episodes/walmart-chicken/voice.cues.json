  "cues": [
    {
      "start": 4.642,
      "end": 6.278,
      "text": "Walmart noticed something strange."
    },
    {
      "start": 6.47,
      "end": 8.509,
      "text": "People weren't just buying its rotisserie chicken."
    },
    {
      "start": 8.71,
      "end": 11.815,
      "text": "They were joking about carrying the bag like a fashion accessory."
    },
    {
      "start": 14.475,
      "end": 16.495,
      "text": "Fifteen thousand social mentions later,"
    },
    {
      "start": 16.75,
      "end": 18.472,
      "text": "the deli bag had a fan base."
    },
    {
      "start": 20.03,
      "end": 21.449,
      "text": "Instead of ignoring the joke,"
    },
    {
      "start": 21.567,
      "end": 22.688,
      "text": "the brand made it real."
    },
    {
      "start": 22.85,
      "end": 26.51,
      "text": "A chicken-shaped purse. Complete with the packaging-inspired design."
    },
    {
      "start": 27.641,
      "end": 30.151,
      "text": "Same type. Same colors. Same chicken."
    },
    {
      "start": 30.37,
      "end": 31.344,
      "text": "Then they added a strap."
    },
    {
      "start": 33.442,
      "end": 36.134,
      "text": "Two flavors: Traditional, with purple trim."
    },
    {
      "start": 36.35,
      "end": 38.155,
      "text": "And Lemon Pepper, in orange."
    },
    {
      "start": 40.043,
      "end": 42.352,
      "text": "And the price? Just five ninety-seven."
    },
    {
      "start": 42.55,
      "end": 45.75,
      "text": "The same price as the rotisserie chicken that inspired it."
    },
    {
      "start": 47.52,
      "end": 48.82,
      "text": "Five thousand purses."
    },
    {
      "start": 48.91,
      "end": 50.55,
      "text": "One drop. September first."
    },
    {
      "start": 51.242,
      "end": 53.727,
      "text": "Plus matching bag charms, because of course."
    },
    {
      "start": 55.192,
      "end": 58.652,
      "text": "When it launched online, the purse sold out in just ninety minutes."
    },
    {
      "start": 61.442,
      "end": 62.677,
      "text": "A second drop followed."
    },
    {
      "start": 62.89,
      "end": 66.361,
      "text": "Resale listings climbed to several times the original price."
    },
    {
      "start": 66.766,
      "end": 67.954,
      "text": "The joke had become merch."
    },
    {
      "start": 68.162,
      "end": 69.304,
      "text": "The merch had become a moment."
    },
    {
      "start": 70.456,
      "end": 73.752,
      "text": "Sometimes, your next big product isn't hiding in a boardroom."
    },
    {
      "start": 73.95,
      "end": 75.861,
      "text": "It's hiding inside a customer joke."
    }
  ]
}
