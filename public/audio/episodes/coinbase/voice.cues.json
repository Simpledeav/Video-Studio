  "cues": [
    {
      "start": 0.78,
      "end": 4.459,
      "text": "What if your software engineers stopped writing most of the code themselves?",
      "lines": [
        "What if your software engineers",
        "stopped writing most of the code themselves?"
      ]
    },
    {
      "start": 7.768,
      "end": 9.573,
      "text": "Software was never just code.",
      "lines": [
        "Software was never just code."
      ]
    },
    {
      "start": 9.74,
      "end": 11.953,
      "text": "Planning, testing, reviewing, shipping.",
      "lines": [
        "Planning, testing, reviewing, shipping."
      ]
    },
    {
      "start": 12.16,
      "end": 16.286,
      "text": "Each step adds time, turning a simple idea into a twenty-day cycle.",
      "lines": [
        "Each step adds time, turning a simple idea",
        "into a twenty-day cycle."
      ]
    },
    {
      "start": 16.48,
      "end": 19.238,
      "text": "The bottleneck wasn't effort. It was the process.",
      "lines": [
        "The bottleneck wasn't effort.",
        "It was the process."
      ]
    },
    {
      "start": 20.648,
      "end": 22.6,
      "text": "So Coinbase changed the workflow.",
      "lines": [
        "So Coinbase changed the workflow."
      ]
    },
    {
      "start": 22.82,
      "end": 25.589,
      "text": "More than twenty-four hundred developers adopted Cursor,",
      "lines": [
        "More than twenty-four hundred developers",
        "adopted Cursor,"
      ]
    },
    {
      "start": 25.784,
      "end": 29.295,
      "text": "directing agents through implementation, testing, and review.",
      "lines": [
        "directing agents through implementation,",
        "testing, and review."
      ]
    },
    {
      "start": 29.5,
      "end": 33.344,
      "text": "The engineer moved up a level: define intent, validate results.",
      "lines": [
        "The engineer moved up a level:",
        "define intent, validate results."
      ]
    },
    {
      "start": 35.945,
      "end": 40.646,
      "text": "In Coinbase's reported workflow, agents created three out of every four pull requests.",
      "lines": [
        "In Coinbase's reported workflow, agents created",
        "three out of every four pull requests."
      ]
    },
    {
      "start": 40.96,
      "end": 43.404,
      "text": "Not a side experiment. The new default.",
      "lines": [
        "Not a side experiment.",
        "The new default."
      ]
    },
    {
      "start": 48.88,
      "end": 51.357,
      "text": "Some teams cut the time from idea to production",
      "lines": [
        "Some teams cut the time from idea to production"
      ]
    },
    {
      "start": 51.368,
      "end": 53.105,
      "text": "from twenty days to less than two.",
      "lines": [
        "from twenty days to less than two."
      ]
    },
    {
      "start": 53.32,
      "end": 54.831,
      "text": "A ninety percent reduction.",
      "lines": [
        "A ninety percent reduction."
      ]
    },
    {
      "start": 55.04,
      "end": 57.695,
      "text": "Not by typing faster, by removing handoffs.",
      "lines": [
        "Not by typing faster, by removing handoffs."
      ]
    },
    {
      "start": 62.768,
      "end": 64.789,
      "text": "The results weren't just about speed.",
      "lines": [
        "The results weren't just about speed."
      ]
    },
    {
      "start": 64.94,
      "end": 67.822,
      "text": "Engineers merged fifty-five percent more pull requests,",
      "lines": [
        "Engineers merged fifty-five percent more",
        "pull requests,"
      ]
    },
    {
      "start": 68.006,
      "end": 69.838,
      "text": "and saved seven hours every week.",
      "lines": [
        "and saved seven hours every week."
      ]
    },
    {
      "start": 69.98,
      "end": 72.92,
      "text": "Small teams started shipping what once took a full team.",
      "lines": [
        "Small teams started shipping",
        "what once took a full team."
      ]
    },
    {
      "start": 76.78,
      "end": 79.323,
      "text": "The biggest shift may not be how fast we write code,",
